# Cổng backend phục vụ API và frontend đã build (dist/)
PORT=8000

# Nhà cung cấp dịch mặc định: anthropic | openai | gemini | deepseek
TRANSLATE_PROVIDER=anthropic
TRANSLATE_MODEL=

# API keys — chỉ điền cái bạn dùng. KHÔNG commit file .env thật.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

# DeepSeek (tương thích OpenAI). Base URL/model mặc định nếu để trống:
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
#   model: deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
